  "source_turns": [
    {
      "index": 0,
      "speaker": "Partner",
      "text": "Hi. I wanted to talk to you about your essay. It isn't on the LMS, and the deadline was Friday."
    },
    {
      "index": 1,
      "speaker": "Learner",
      "text": "Really? I sent it to you by email on Thursday evening. Sorry, what's the LMS?"
    },
    {
      "index": 2,
      "speaker": "Partner",
      "text": "The Learning Management System. It's the course website. I said, 'Send it through the LMS.'"
    },
    {
      "index": 3,
      "speaker": "Learner",
      "text": "Oh, I understand now. I only heard 'send it', so I thought email was fine. I didn't know it had to go on the website."
    },
    {
      "index": 4,
      "speaker": "Partner",
      "text": "That's okay. A few students made the same mistake."
    },
    {
      "index": 5,
      "speaker": "Learner",
      "text": "Can I upload it today? I can do it right after this."
    },
    {
      "index": 6,
      "speaker": "Partner",
      "text": "Yes. If it's there before five, it counts as on time."
    },
    {
      "index": 7,
      "speaker": "Learner",
      "text": "Great, thank you. Where do I put it on the website?"
    },
    {
      "index": 8,
      "speaker": "Partner",
      "text": "Under 'Week 6', then 'Essay'."
    },
    {
      "index": 9,
      "speaker": "Learner",
      "text": "Okay. Week 6, then 'Essay', before five. Thank you."
    }
  ],
