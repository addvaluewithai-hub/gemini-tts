  "source_turns": [
    {
      "index": 0,
      "speaker": "Partner",
      "text": "Hello, Sea View Hotel. How can I help?"
    },
    {
      "index": 1,
      "speaker": "Learner",
      "text": "Hi. I have a reservation for next Tuesday and Wednesday, under the name Sam. Could I possibly change the dates? My work trip has moved one day later."
    },
    {
      "index": 2,
      "speaker": "Partner",
      "text": "Of course. So you'd like Wednesday and Thursday instead?"
    },
    {
      "index": 3,
      "speaker": "Learner",
      "text": "Yes, that's right. And I need a desk, because I'll be working in my room."
    },
    {
      "index": 4,
      "speaker": "Partner",
      "text": "Your room is free on Wednesday, but not on Thursday. On Thursday I have a smaller room for sixty dollars, but it doesn't have a desk."
    },
    {
      "index": 5,
      "speaker": "Learner",
      "text": "Thank you, but I really need a desk. Without one, I can't work. Is there another room with a desk?"
    },
    {
      "index": 6,
      "speaker": "Partner",
      "text": "There's a larger room with a desk for ninety dollars. That's twenty more than your room."
    },
    {
      "index": 7,
      "speaker": "Learner",
      "text": "It's only for one night, so that's fine. I'll take the larger room on Thursday."
    },
    {
      "index": 8,
      "speaker": "Partner",
      "text": "Okay. Your room on Wednesday for seventy, and the larger room on Thursday for ninety."
    },
    {
      "index": 9,
      "speaker": "Learner",
      "text": "Great. And there's no charge for changing the dates, right?"
    },
    {
      "index": 10,
      "speaker": "Partner",
      "text": "No charge at all. See you on Wednesday!"
    }
  ],
