  "source_turns": [
    {
      "index": 0,
      "speaker": "Partner",
      "text": "Hey, I'm really sorry, but I have bad news. My manager asked me to finish a report tonight, so I can't leave until eight."
    },
    {
      "index": 1,
      "speaker": "Learner",
      "text": "Oh no, but the game starts at seven! That's a shame. So you'll miss most of it?"
    },
    {
      "index": 2,
      "speaker": "Partner",
      "text": "I know. From here to our café is about forty minutes. You could start watching without me."
    },
    {
      "index": 3,
      "speaker": "Learner",
      "text": "I don't want to watch the whole game alone. Is there a café near your office? Then you could join me sooner."
    },
    {
      "index": 4,
      "speaker": "Partner",
      "text": "There's a good one across the street, with a big screen. I could be there at ten past eight. But it's far from your home."
    },
    {
      "index": 5,
      "speaker": "Learner",
      "text": "That's okay, it's about thirty minutes by metro. I'd rather go a bit further and watch the second half together."
    },
    {
      "index": 6,
      "speaker": "Partner",
      "text": "Great! I'll try to finish early. I'll send you the name of the café."
    },
    {
      "index": 7,
      "speaker": "Learner",
      "text": "Perfect. So I'll be at the café near your office before seven, and you'll come at about ten past eight."
    },
    {
      "index": 8,
      "speaker": "Partner",
      "text": "Deal. Save me a seat!"
    }
  ],
